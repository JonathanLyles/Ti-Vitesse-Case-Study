<?xml version="1.0" encoding="UTF-8" ?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customErrors>
        <description
    >Explains to user they can only update Status and Closed Date on a case where the current status is closed.</description>
        <name>Update_not_Allowed</name>
        <label>Update not Allowed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage
      >When a case is closed, only the following fields can be updated: Status, Closed Date.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <description
    >Once a case is closed, a sales agent and a sales manager can only update the following fields: Status, Closed Date. An administrator can update all fields.</description>
        <name>iSAuthorized</name>
        <label>iSAuthorized</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Authorized</defaultConnectorLabel>
        <rules>
            <name>Not_Authorized</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsAgentOrSalesManager</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_not_Allowed</targetReference>
            </connector>
            <label>Not Authorized</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>IsAgentOrSalesManager</name>
        <dataType>Boolean</dataType>
        <expression>OR( 
CONTAINS({!$UserRole.Name},&quot;Agent&quot; ),
CONTAINS({!$UserRole.Name},&quot;Sales Manager&quot; ) 
)</expression>
    </formulas>
    <formulas>
        <name>SalesAgentUserRoleString</name>
        <dataType>String</dataType>
        <expression>&apos;Agent&apos;</expression>
    </formulas>
    <formulas>
        <name>SalesManagerUserRoleString</name>
        <dataType>String</dataType>
        <expression>&apos;Sales Manager&apos;</expression>
    </formulas>
    <interviewLabel
  >Closed Case Update Rule Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Closed Case Update Rule Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>iSAuthorized</targetReference>
        </connector>
        <filterLogic
    >(1 AND 2 ) AND (3 OR 4 OR 5 OR 6 OR 7 OR 8 OR 9 OR 10)</filterLogic>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>ContactId</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Subject</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Repair_Possible__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Repair_Details__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Priority</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Description</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Origin</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>AccountId</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
