<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Contact_field_is_required</fullName>
    <active>true</active>
    <description
  >Checks if a damaged vehicle has a contact. Does not apply to loan vehicles.</description>
    <errorConditionFormula
  >AND( RecordType.DeveloperName = &apos;Damaged_Vehicle&apos;, ISBLANK( Contact__c ) )</errorConditionFormula>
    <errorMessage>Contact is required</errorMessage>
</ValidationRule>
